# Careers-only configuration reference. Do not copy production database credentials for local QA.
# Reference values only; preserve existing provider credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/9jobs_careers_test
CAREERS_APPLICATIONS_ENABLED=true

# Email delivery requires this flag in every environment.
CAREERS_EMAIL_ENABLED=false
# Development also requires explicit permission to send real applicant/admin emails.
# Keep false for routine local QA and enable only for authorised real submissions.
CAREERS_ALLOW_LIVE_EMAIL_IN_DEVELOPMENT=false
# Defaults to the existing ADMIN_EMAIL when left empty.
CAREERS_NOTIFICATION_EMAIL=

# Reuse the existing configured email service; never replace its credentials here.
# Existing keys: MAIL_FROM, EMAIL_PROVIDER, SENDGRID_API_KEY
# Gmail alternative: GMAIL_PASS, GMAIL_USER (or existing MAIL_FROM fallback)
# Keep live delivery disabled during routine local QA.
# Production delivery uses the existing sendEmail provider and credentials.
# Isolated local SMTP integration tests may set CAREERS_EMAIL_TRANSPORT=local,
# CAREERS_SMTP_HOST=127.0.0.1 and CAREERS_SMTP_PORT=2525.
# That transport only accepts .test recipients and never contacts an external SMTP server.
# Failed deliveries retain per-recipient state/attempts in career_applications.
# Delivery states 'sending' require provider reconciliation before manual retry.

# Admin applications: /admin/careers (existing admin sign-in required).
# Private resume downloads use /api/admin/careers/[id]/resume.
# No public application/resume read route is exposed.
